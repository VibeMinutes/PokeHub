            while getgenv().DailyEnabled and getgenv().DailySession == mySession do
                local ok, result = pcall(function()
                    return game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("ClaimDaily"):InvokeServer()
                end)
                print("ClaimDaily ->", ok, result)

                task.wait(60)
            end
        end)
    end,
}, "AutoClaimDailyToggle")

MiscLeftSection:Toggle({
    Name = "Auto Claim Playtime Reward",
    Default = false,
    Callback = function(value)
        print("Auto Claim Playtime:", value)

        getgenv().PlaytimeEnabled = value
        getgenv().PlaytimeSession = (getgenv().PlaytimeSession or 0) + 1
        if not value then return end
        local mySession = getgenv().PlaytimeSession

        local MaxReward = 3

        local function active()
            return getgenv().PlaytimeEnabled and getgenv().PlaytimeSession == mySession
        end

        task.spawn(function()
            while active() do
                for id = 1, MaxReward do
                    if not active() then break end

                    local ok, result = pcall(function()
                        return game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("ClaimReward"):InvokeServer(id)
                    end)
                    if not ok then
                        warn("ClaimReward Error: ", result)
                    end

                    task.wait(0.5)
                end

                task.wait(30)
            end
        end)
    end,
}, "AutoPlaytimeToggle")

MiscRightSection:Button({
    Name = "Redeem All Codes",
    Callback = function()
        local Codes = {
            "UPDATE2",
            "KURUMA",
            "1MILLIONVISITS",
            "NEWWORLDS",
            "UPDATE1",
            "SHARINGAN",
            "AWAKEN",
        }

        task.spawn(function()
            local success, failed = 0, 0

            for _, code in ipairs(Codes) do
                local ok, result = pcall(function()
                    return game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("RedeemCode"):InvokeServer(code)
                end)
                print("Redeem", code, "->", ok, result)

                if ok and result then
                    success += 1
                else
                    failed += 1
                end

                task.wait(1)
            end

            Window:Notify({
                Title = "Poke Hub",
                Description = "Redeem finished: " .. success .. " ok, " .. failed .. " failed",
                Lifetime = 6
            })
        end)
    end,
})

