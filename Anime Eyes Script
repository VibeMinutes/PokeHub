local hookOK = false
if not getgenv().StageHookInstalled and hookmetamethod and getnamecallmethod and newcclosure then
    hookOK = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if typeof(self) == "Instance" and self.Name == "Report" and getnamecallmethod() == "FireServer" then
                local data = ...
                if type(data) == "table" then
                    if data.doing == "Wave" then
                        getgenv().StageWaveAt = os.clock()
                    elseif data.doing == "Stages" then
                        getgenv().StageClearAt = os.clock()
                    end
                end
            end
            return old(self, ...)
        end))
    end)
    getgenv().StageHookInstalled = hookOK
else
    hookOK = getgenv().StageHookInstalled == true
end

local function getMonsters(center, radius)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character }

    local list, seen = {}, {}
    for _, part in ipairs(workspace:GetPartBoundsInRadius(center, radius, params)) do
        local m = part
        while m and m ~= workspace do
            if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then break end
            m = m.Parent
        end
        if m and m ~= workspace and not seen[m] then
            seen[m] = true
            local hum = m:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 and not game:GetService("Players"):GetPlayerFromCharacter(m) then
                local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or part
                table.insert(list, root.Position)
            end
        end
    end
    return list
end

getgenv().SilentAim = getgenv().SilentAim or {
    Enabled = false,
    Monsters = true,
    Players = false,
    Radius = 150,
}

local function getSilentTarget()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local cfg = getgenv().SilentAim
    local best, bestDist = nil, math.huge

    if cfg.Monsters then
        for _, pos in ipairs(getMonsters(hrp.Position, cfg.Radius)) do
            local d = (pos - hrp.Position).Magnitude
            if d < bestDist then best, bestDist = pos, d end
        end
    end

    if cfg.Players then
        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
            local c = p ~= player and p.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                local d = (r.Position - hrp.Position).Magnitude
                if d <= cfg.Radius and d < bestDist then
                    best, bestDist = r.Position, d
                end
            end
        end
    end

    return best
end

local function SetAutoSkill(value)
    getgenv().SkillEnabled = value
    getgenv().SkillSession = (getgenv().SkillSession or 0) + 1
    if not value then return end
    local mySession = getgenv().SkillSession

    local Skills = { "E", "R" }
    local Delay = 0.5
    local mouse = player:GetMouse()

    local function active()
        return getgenv().SkillEnabled and getgenv().SkillSession == mySession
    end

    task.spawn(function()
        while active() do
            local aimPos
            if getgenv().SilentAim.Enabled then
                aimPos = getSilentTarget()
            end
            aimPos = aimPos or getgenv().AttackOverride or (mouse and mouse.Hit and mouse.Hit.Position)

            if aimPos then
                for _, key in ipairs(Skills) do
                    if not active() then break end
                    local ok, err = pcall(function()
                        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Cast"):FireServer(key, aimPos)
                    end)
                    if not ok then warn("Skill " .. key .. " Error: ", err) end
                    task.wait(0.1)
                end
            end

            task.wait(Delay)
        end
    end)
end

local AutoStageToggle
AutoStageToggle = FarmLeftSection:Toggle({
    Name = "Auto Stage",
    Default = false,
    Callback = function(value)
        print("Auto Stage:", value)

        getgenv().StageEnabled = value
        getgenv().StageSession = (getgenv().StageSession or 0) + 1

        if not value then
            getgenv().AttackOverride = nil
            if not getgenv().Enabled and not getgenv().BossEnabled then
                SetAutoClick(false)
                SetAutoSkill(false)
            end
            return
        end

        local mySession = getgenv().StageSession

        local StartStage = 1
        local Height = getgenv().KuySettings.StageHeight
        local Radius = 45
        local KillAura = true
        local Timeout = 120
        local LowHP = 0.4
        local ResumeHP = 0.8
        local SafeHeight = 40
        local inSafe = false
        local HopAlways = false
        local HopInterval = 0.35
        local HopSpots = {
            Vector3.new(25, 0, 0),
            Vector3.new(0, 0, 25),
            Vector3.new(-25, 0, 0),
            Vector3.new(0, 0, -25),
        }
        local hopIndex = 1
        local lastHop = 0

        local Stages = {
            [1]  = CFrame.new(1.88, 2.98, -71.91),
            [2]  = CFrame.new(0.54, 2.98, -162.58),
            [3]  = CFrame.new(2.29, 2.98, -250.17),
            [4]  = CFrame.new(0.98, 2.98, -344.73),
            [5]  = CFrame.new(-0.35, 2.98, -430.96),
            [6]  = CFrame.new(-0.06, 2.98, -519.15),
            [7]  = CFrame.new(-0.14, 2.98, -610.05),
            [8]  = CFrame.new(-0.22, 2.97, -700.95),
            [9]  = CFrame.new(-0.14, 2.98, -790.98),
            [10] = CFrame.new(3.17, 2.98, -884.83),
            [11] = CFrame.new(0, 2.98, -975.2),
            [12] = CFrame.new(0, 2.98, -1065.5),
            [13] = CFrame.new(0, 2.98, -1155.9),
            [14] = CFrame.new(0, 2.98, -1246.2),
            [15] = CFrame.new(0, 2.98, -1336.5),
        }

        local function active()
            return getgenv().StageEnabled and getgenv().StageSession == mySession
        end

        local function notify(text)
            Window:Notify({ Title = "Poke Hub", Description = text, Lifetime = 5 })
        end

        local function claimPad(stage, waitRespawn)
            local pad = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Pad")

            local function fire()
                local ok, err = pcall(function()
                    pad:FireServer(stage, "gold")
                end)
                if not ok then warn("Pad Error: ", err) end
            end

            if waitRespawn then
                for _ = 1, 3 do
                    fire()
                    task.wait(0.4)
                end

                local t0 = os.clock()
                repeat
                    task.wait(0.3)
                    local char = player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                until (hum and hum.Health > 0) or os.clock() - t0 > 10
            else
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local cf = Stages[stage]
                if hrp and cf then
                    hrp.CFrame = cf + Vector3.new(0, 3, 0)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
                task.wait(1.5)
            end

            for _ = 1, 5 do
                fire()
                task.wait(0.5)
            end

            notify("Sent pad claim: stage " .. stage .. " (check your rewards)")
        end

        local function isDead()
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            return (not hum) or hum.Health <= 0
        end

        local function stopAll(reason)
            notify(reason)
            getgenv().StageEnabled = false
            getgenv().StageSession = (getgenv().StageSession or 0) + 1
            getgenv().AttackOverride = nil
            if not getgenv().Enabled and not getgenv().BossEnabled then
                SetAutoClick(false)
                SetAutoSkill(false)
            end
            pcall(function() AutoStageToggle:UpdateState(false) end)
        end

        SetAutoClick(true)
        SetAutoSkill(true)

        task.spawn(function()
            for stage = StartStage, 15 do
                if not active() then return end

                local cf = Stages[stage]
                local hoverPos = cf.Position + Vector3.new(0, Height, 0)
                local targetPos = hoverPos
                local startedAt = os.clock()
                local seenMonster = false
                local emptySince = nil
                notify("Stage " .. stage)

                while active() do
                    if isDead() then
                        claimPad(stage, true)
                        stopAll("You died at stage " .. stage .. " - Auto Stage stopped")
                        return
                    end

                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local myHum = char and char:FindFirstChildOfClass("Humanoid")

                    if myHum and myHum.MaxHealth > 0 then
                        local ratio = myHum.Health / myHum.MaxHealth
                        if not inSafe and ratio <= LowHP then
                            inSafe = true
                            notify("Low HP - dodging")
                        elseif inSafe and ratio >= ResumeHP then
                            inSafe = false
                            notify("HP recovered - back to fight")
                        end
                    end

                    if HopAlways or inSafe then
                        if os.clock() - lastHop >= HopInterval then
                            lastHop = os.clock()
                            hopIndex = hopIndex % #HopSpots + 1
                        end
                        local h = inSafe and SafeHeight or Height
                        targetPos = cf.Position + HopSpots[hopIndex] + Vector3.new(0, h, 0)
                    else
                        targetPos = hoverPos
                    end

                    if hrp then
                        hrp.CFrame = CFrame.new(targetPos)
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end

                    local monsters = getMonsters(cf.Position, Radius)
                    if #monsters > 0 then
                        seenMonster = true
                        emptySince = nil

                        table.sort(monsters, function(a, b)
                            return (a - targetPos).Magnitude < (b - targetPos).Magnitude
                        end)
                        getgenv().AttackOverride = monsters[1]

                        if KillAura then
                            for i = 2, math.min(#monsters, 5) do
                                pcall(function()
                                    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Cast"):FireServer("attack", monsters[i])
                                end)
                            end
                        end
                    else
                        getgenv().AttackOverride = cf.Position
                        if seenMonster then
                            emptySince = emptySince or os.clock()
                            if os.clock() - emptySince >= 0.3 then
                                notify("Stage " .. stage .. " cleared")
                                task.wait(0.1)
                                break
                            end
                        end
                    end

                    if hookOK and getgenv().StageClearAt > getgenv().StageWaveAt
                        and getgenv().StageWaveAt > startedAt then
                        task.wait(0.1)
                        break
                    end

                    if os.clock() - startedAt >= Timeout then
                        notify("Stage " .. stage .. " timeout - moving on")
                        break
                    end

                    task.wait(0.1)
                end
            end

            if active() then
                claimPad(15, false)
                stopAll("All 15 stages completed")
            end
        end)
    end,
}, "AutoStageToggle")

