local function SetAutoClick(value)
    getgenv().ClickEnabled = value
    getgenv().ClickSession = (getgenv().ClickSession or 0) + 1
    if not value then return end
    local mySession = getgenv().ClickSession

    local mouse = player:GetMouse()

    -- ลูปที่ 1: โจมตีตามตำแหน่งเมาส์
    task.spawn(function()
        while getgenv().ClickEnabled and getgenv().ClickSession == mySession do
            local aimPos = getgenv().AttackOverride or (mouse and mouse.Hit and mouse.Hit.Position)
            if aimPos then
                local args = {
                    "attack",
                    aimPos
                }

                local success, err = pcall(function()
                    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Cast"):FireServer(unpack(args))
                end)

                if not success then
                    warn("Cast Remote Error: ", err)
                end
            end

            task.wait(getgenv().KuySettings.ClickDelay)
        end
    end)

    -- ลูปที่ 2: Train
    task.spawn(function()
        while getgenv().ClickEnabled and getgenv().ClickSession == mySession do
            local success, err = pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Train"):FireServer()
            end)

            if not success then
                warn("Train Remote Error: ", err)
            end

            task.wait(getgenv().KuySettings.ClickDelay)
        end
    end)
end

