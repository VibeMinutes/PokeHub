            "NEWWORLDS",
            "UPDATE1",
            "SHARINGAN",
            "AWAKEN",
        }

        task.spawn(function()
            local success, failed = 0, 0

            for _, code in ipairs(Codes) do
                local ok, result = pcall(function()
                    return game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("RedeemCode"):InvokeServer(code)
                end)
                print("Redeem", code, "->", ok, result)

                if ok and result then
                    success += 1
                else
                    failed += 1
                end

                task.wait(1)
            end

            Window:Notify({
                Title = "Poke Hub",
                Description = "Redeem finished: " .. success .. " ok, " .. failed .. " failed",
                Lifetime = 6
            })
        end)
    end,
})

